<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 640 140" width="640" height="140"
     role="img" aria-label="Salut, je suis Cloud — Développeur Junior — Passionné de Sécurité">

  <defs>
    <style><![CDATA[
      /* ---- Palette : modifie ces 5 valeurs pour changer tout le rendu ---- */
      :root {
        --main:   #E8F6FF;  /* texte principal */
        --cyan:   #5FD3F3;  /* calque decale 1 */
        --magenta:#F25CA2;  /* calque decale 2 */
        --accent: #87CEEB;  /* crochets + soulignement */
        --panel:  #0D1117;  /* fond du bandeau */
      }

      .panel  { fill: var(--panel); }
      .border { fill: none; stroke: var(--accent); stroke-opacity: .25; stroke-width: 1; }

      text {
        font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, "Liberation Mono", monospace;
        font-size: 30px;
        font-weight: 700;
        text-anchor: middle;
        letter-spacing: .5px;
      }

      .main    { fill: var(--main); }
      .cyan    { fill: var(--cyan);    opacity: .85; mix-blend-mode: screen; }
      .magenta { fill: var(--magenta); opacity: .75; mix-blend-mode: screen; }

      /* ---- Cycle entre les 3 phrases ---- */
      .phrase { opacity: 0; animation: cycle 9s infinite; }
      .p1 { animation-delay: 0s; }
      .p2 { animation-delay: 3s; }
      .p3 { animation-delay: 6s; }

      @keyframes cycle {
        0%   { opacity: 0; }
        1.5% { opacity: 1; }
        31%  { opacity: 1; }
        32%  { opacity: 0; }
        100% { opacity: 0; }
      }

      /* ---- Decalage des calques colores : rafales au debut et au milieu ---- */
      .phrase .cyan    { animation: driftC 9s infinite; }
      .phrase .magenta { animation: driftM 9s infinite; }
      .p1 .cyan, .p1 .magenta { animation-delay: 0s; }
      .p2 .cyan, .p2 .magenta { animation-delay: 3s; }
      .p3 .cyan, .p3 .magenta { animation-delay: 6s; }

      @keyframes driftC {
        0%, 1%   { transform: translate(-7px, 2px); }
        2%       { transform: translate(4px, -2px); }
        3%       { transform: translate(-2px, 0); }
        4%, 15%  { transform: translate(-1.5px, 0); }
        16%      { transform: translate(-6px, 1px); }
        17%      { transform: translate(3px, -1px); }
        18%, 26% { transform: translate(-1.5px, 0); }
        27%      { transform: translate(5px, 1px); }
        28%,100% { transform: translate(-1.5px, 0); }
      }
      @keyframes driftM {
        0%, 1%   { transform: translate(7px, -2px); }
        2%       { transform: translate(-4px, 2px); }
        3%       { transform: translate(2px, 0); }
        4%, 15%  { transform: translate(1.5px, 0); }
        16%      { transform: translate(6px, -1px); }
        17%      { transform: translate(-3px, 1px); }
        18%, 26% { transform: translate(1.5px, 0); }
        27%      { transform: translate(-5px, -1px); }
        28%,100% { transform: translate(1.5px, 0); }
      }

      /* ---- Tranches horizontales qui sautent ---- */
      .slice { animation: sliceJump 9s infinite; }
      .p1 .slice { animation-delay: 0s; }
      .p2 .slice { animation-delay: 3s; }
      .p3 .slice { animation-delay: 6s; }
      .s2 { animation-duration: 9s; animation-name: sliceJump2; }
      .s3 { animation-duration: 9s; animation-name: sliceJump3; }

      @keyframes sliceJump {
        0%, 1.4%  { transform: translateX(12px); }
        1.5%, 15.4% { transform: translateX(0); }
        15.5%, 16.4% { transform: translateX(-9px); }
        16.5%, 100% { transform: translateX(0); }
      }
      @keyframes sliceJump2 {
        0%, 1.9%  { transform: translateX(-14px); }
        2%, 21.4% { transform: translateX(0); }
        21.5%, 22.4% { transform: translateX(7px); }
        22.5%, 100% { transform: translateX(0); }
      }
      @keyframes sliceJump3 {
        0%, 1.2%  { transform: translateX(9px); }
        1.3%, 26.4% { transform: translateX(0); }
        26.5%, 27.4% { transform: translateX(-11px); }
        27.5%, 100% { transform: translateX(0); }
      }

      /* ---- Barre de balayage + scintillement global ---- */
      .sweep { fill: var(--accent); opacity: .07; animation: sweep 4.5s linear infinite; }
      @keyframes sweep {
        0%   { transform: translateY(-30px); }
        100% { transform: translateY(150px); }
      }

      .flicker { animation: flicker 9s infinite; }
      @keyframes flicker {
        0%, 1%, 2%, 3%, 15.6%, 16.2%, 27%, 27.6% { opacity: .55; }
        1.5%, 2.5%, 4%, 15.9%, 16.6%, 27.3%, 28%, 100% { opacity: 1; }
      }

      .brackets { fill: var(--accent); font-size: 30px; font-weight: 700; opacity: .55; }
      .rule { stroke: var(--accent); stroke-width: 2; stroke-opacity: .5; }

      /* Respecte le reglage systeme "reduire les animations" */
      @media (prefers-reduced-motion: reduce) {
        .phrase, .cyan, .magenta, .slice, .sweep, .flicker { animation: none; }
        .p1 { opacity: 1; }
        .p2, .p3 { opacity: 0; }
      }
    ]]></style>

    <clipPath id="band1"><rect x="0" y="40" width="640" height="18" /></clipPath>
    <clipPath id="band2"><rect x="0" y="58" width="640" height="16" /></clipPath>
    <clipPath id="band3"><rect x="0" y="74" width="640" height="20" /></clipPath>

    <pattern id="scan" width="4" height="4" patternUnits="userSpaceOnUse">
      <rect width="4" height="2" fill="#000" opacity=".18" />
    </pattern>

    <g id="t1"><text x="320" y="78">Salut, je suis Cloud 👋</text></g>
    <g id="t2"><text x="320" y="78">Développeur Junior</text></g>
    <g id="t3"><text x="320" y="78">Passionné de Sécurité</text></g>
  </defs>

  <rect class="panel" x="0" y="0" width="640" height="140" rx="10" />
  <rect class="border" x="0.5" y="0.5" width="639" height="139" rx="10" />

  <text class="brackets" x="46" y="78">&#123;</text>
  <text class="brackets" x="594" y="78">&#125;</text>

  <g class="flicker">
    <!-- Phrase 1 -->
    <g class="phrase p1">
      <use href="#t1" xlink:href="#t1" class="cyan" />
      <use href="#t1" xlink:href="#t1" class="magenta" />
      <use href="#t1" xlink:href="#t1" class="main" />
      <g clip-path="url(#band1)"><g class="slice s1"><use href="#t1" xlink:href="#t1" class="main" /></g></g>
      <g clip-path="url(#band2)"><g class="slice s2"><use href="#t1" xlink:href="#t1" class="main" /></g></g>
      <g clip-path="url(#band3)"><g class="slice s3"><use href="#t1" xlink:href="#t1" class="main" /></g></g>
    </g>

    <!-- Phrase 2 -->
    <g class="phrase p2">
      <use href="#t2" xlink:href="#t2" class="cyan" />
      <use href="#t2" xlink:href="#t2" class="magenta" />
      <use href="#t2" xlink:href="#t2" class="main" />
      <g clip-path="url(#band1)"><g class="slice s1"><use href="#t2" xlink:href="#t2" class="main" /></g></g>
      <g clip-path="url(#band2)"><g class="slice s2"><use href="#t2" xlink:href="#t2" class="main" /></g></g>
      <g clip-path="url(#band3)"><g class="slice s3"><use href="#t2" xlink:href="#t2" class="main" /></g></g>
    </g>

    <!-- Phrase 3 -->
    <g class="phrase p3">
      <use href="#t3" xlink:href="#t3" class="cyan" />
      <use href="#t3" xlink:href="#t3" class="magenta" />
      <use href="#t3" xlink:href="#t3" class="main" />
      <g clip-path="url(#band1)"><g class="slice s1"><use href="#t3" xlink:href="#t3" class="main" /></g></g>
      <g clip-path="url(#band2)"><g class="slice s2"><use href="#t3" xlink:href="#t3" class="main" /></g></g>
      <g clip-path="url(#band3)"><g class="slice s3"><use href="#t3" xlink:href="#t3" class="main" /></g></g>
    </g>
  </g>

  <line class="rule" x1="240" y1="100" x2="400" y2="100" />

  <rect x="0" y="0" width="640" height="140" fill="url(#scan)" rx="10" />
  <rect class="sweep" x="0" y="0" width="640" height="26" rx="4" />
</svg>
